# Development Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Set environment variables
ENV NODE_ENV=development
ENV VITE_API_BASE_URL=http://localhost:3000/api

# Start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
